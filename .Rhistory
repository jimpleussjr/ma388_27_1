between(plate_x*12,-plate_width/2-2,plate_width/2+2) &
between(plate_z*12,sz_top*12-2,sz_top*12+2) ~ TRUE,
between(plate_x*12,-plate_width/2-2,plate_width/2+2) &
between(plate_z*12,sz_bot*12-2,sz_bot*12+2) ~ TRUE,
between(plate_x*12,-plate_width/2-2,-plate_width/2+2) &
between(plate_z*12,sz_bot*12-2,sz_top*12+2) ~ TRUE,
between(plate_x*12,plate_width/2-2,plate_width/2+2) &
between(plate_z*12,sz_bot*12-2,sz_top*12+2) ~ TRUE,)) |>
filter(close_pitch)
pitches_taken |>
mutate(close_pitch = case_when(
between(plate_x*12,-plate_width/2-2,plate_width/2+2) &
between(plate_z*12,sz_top*12-2,sz_top*12+2) ~ TRUE,
between(plate_x*12,-plate_width/2-2,plate_width/2+2) &
