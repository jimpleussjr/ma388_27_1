library(modelr) #data_grid function
# Create a grid.
grid <- pitches_taken_subset |>
data_grid(plate_x = seq_range(plate_x, n = 100),
plate_z = seq_range(plate_z, n = 100))
grid |> head(5)
# Calculate predicted probabilities for strikes on the grid.
