library(tidyverse)
library(Lahman)
library(knitr)
library(ggrepel)
library(broom)
teams2018 <- Teams |>
filter(yearID == 2018) |>
mutate(Wpct = W/(W+L),
logWL = log(W/L),
logRRA = log(R/RA))
k <- teams2018 |>
lm(logWL ~ 0 + logRRA, data = _) |>
tidy() |>
pull(estimate)
k
my_teams = Teams |>
filter(yearID==2018) |>
mutate(logWratio = log(W/L),
logRratio = log(R/RA))
my_teams
# Including 0 in formula means we don't include an intercept.
pythFit <- lm(logWratio ~ 0 + logRratio, data = my_teams)
pythFit
