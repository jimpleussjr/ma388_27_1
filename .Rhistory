install.packages('Lahman')
knitr::opts_chunk$set(echo = TRUE,
message = FALSE,
warning = FALSE)
Teams
library(Lahman)
library(tidyverse)
library(knitr)
library(broom)
library(ggrepel)
# Add run difference and win percentage.
teams2024 <- Teams |>
filter(yearID == '2025') |>
mutate(RD = R - RA,
Wpct = W / (W + L))
# Plot WPCT vs. RD.
teams2024 |>
ggplot(aes(x = RD, y = Wpct, label = teamID)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
geom_text_repel()
# Fit the model.
model <- teams2024 |>
lm(Wpct ~ RD, data = _)
# Display model summary as a table.
model |>
tidy() |>
kable()
# Get residuals.
teams2024 <- augment(model, data = teams2024)
# Plot fitted values vs. residuals.
teams2024 |>
ggplot(aes(x = .fitted, y = .resid, label = teamID)) +
geom_point() +
geom_text_repel()
# Your code here.
coefs <- model |>
tidy() |>
pull(estimate)
RPW <- (coefs[2] * 162)^-1
RPW
library(baseballr)
retro2024 <-
retrosheet_data(years_to_acquire = '2024') |>
pluck('2024') |>
pluck('events')
# Add states and run values, output as retro_event_run_value
# Also gives the run expectancy matrix as erm_wide
source("./RunExpectancyMatrixFunctions.R")
get_run_expectancy_retro(retro2024)
library(baseballr)
retro2024 <-
retrosheet_data(years_to_acquire = '2025') |>
pluck('2025') |>
pluck('events')
# Add states and run values, output as retro_event_run_value
# Also gives the run expectancy matrix as erm_wide
source("./RunExpectancyMatrixFunctions.R")
get_run_expectancy_retro(retro2024)
#frequency distributions
state_freq <- retro_event_run_value |>
filter(state == "100 0",bat_event_fl == TRUE) |>
count(new_state, run_value, bunt_fl) |>
# group_by(bunt_fl) |>
mutate(p = n/sum(n))
#create table
state_freq |>
pivot_wider(id_cols = c(run_value, new_state),
names_from = bunt_fl,
values_from = p) |>
kable(digits = 3, caption = "Frequency distribution of run values when
bunting and not bunting with a runner on first and no outs (2024)")
#expected run values
state_freq |>
group_by(bunt_fl) |>
summarize(expected_run_value = sum(run_value*p, na.rm = TRUE)) |>
kable(digits = 3, caption = "Expected run values - bunting and not
bunting with a runner on first and no outs (2024)")
#frequency distributions
state_freq2 <- retro_event_run_value |>
filter(state == "100 0") |>
count(new_state, run_value, bunt_fl) |>
# group_by(bunt_fl) |>
mutate(p = n/sum(n),.by=bunt_fl)
#create table
state_freq2 |>
pivot_wider(id_cols = c(run_value, new_state),
names_from = bunt_fl,
values_from = p) |>
kable(digits = 3, caption = "Frequency distribution of run values when
bunting and not bunting with a runner on first and no outs (2024)")
#expected run values
state_freq2 |>
group_by(bunt_fl) |>
summarize(expected_run_value = sum(run_value*p, na.rm = TRUE)) |>
kable(digits = 3, caption = "Expected run values - bunting and not
bunting with a runner on first and no outs (2024)")
#frequency distributions
state_freq3 <- retro_event_run_value |>
filter(state == "100 0", bat_event_fl) |>
count(new_state, run_value, bunt_fl) |>
# group_by(bunt_fl) |>
mutate(p = n/sum(n),.by=bunt_fl)
#create table
state_freq3 |>
pivot_wider(id_cols = c(run_value, new_state),
names_from = bunt_fl,
values_from = p) |>
kable(digits = 3, caption = "Frequency distribution of run values when
bunting and not bunting with a runner on first and no outs (2024)")
#expected run values
state_freq3 |>
group_by(bunt_fl) |>
summarize(expected_run_value = sum(run_value*p, na.rm = TRUE)) |>
kable(digits = 3, caption = "Expected run values - bunting and not
bunting with a runner on first and no outs (2024)")
#calculate Batting Average
avg2024 <- Batting |>
group_by(playerID) |>
summarize(H = sum(H),
AB = sum(AB)) |>
mutate(AVG = H/AB)
#add retroID from People
avg2024 <- avg2024 |>
left_join(select(People, playerID, retroID))
#add batting average to retro2024
retro_event_run_value <- retro_event_run_value |>
left_join(avg2024, by = c("bat_id" = "retroID"))
#calculate average batting average for bunters vs non-bunters
averages_by_bunt <- retro_event_run_value |>
group_by(bunt_fl) |>
summarize(AVG = mean(AVG, na.rm = TRUE))
#plot histograms
retro_event_run_value |>
ggplot(aes(x = AVG)) +
geom_histogram() +
geom_vline(data = averages_by_bunt, aes(xintercept = AVG), color = "red") +
facet_wrap(~bunt_fl, ncol = 1, scales = "free_y")
